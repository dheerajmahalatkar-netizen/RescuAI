rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // 2. Triage & Validation helpers
    function isValidUser(data) {
      return data.keys().hasAll(['fullName', 'phoneNumber', 'emergencyContacts'])
             && data.fullName is string && data.fullName.size() <= 100
             && data.phoneNumber is string && data.phoneNumber.size() <= 20
             && data.emergencyContacts is list && data.emergencyContacts.size() <= 10;
    }

    function isValidEmergency(data) {
      return data.userId == request.auth.uid
             && data.type is string
             && data.status in ['active', 'resolved', 'cancelled'];
    }

    // --- Collections ---

    match /users/{userId} {
      allow get: if isSignedIn(); // Allow reading profile for contact lookup etc.
      allow create, update: if isOwner(userId) && isValidUser(incoming());
      allow list: if isSignedIn() && resource.data.phoneNumber == request.auth.token.phone_number;
    }

    match /emergencies/{emergencyId} {
      allow get: if true; // Public access for tracking links
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidEmergency(incoming());
      allow update: if isSignedIn() && existing().userId == request.auth.uid && (
        // Action: Update details or location
        (incoming().diff(existing()).affectedKeys().hasOnly([
          'description', 'voiceInput', 'imageUrl', 'type', 'severity', 'status', 
          'assistanceSteps', 'location', 'updatedAt', 'notes', 'firstAidAdvice', 
          'language', 'chatHistory'
        ]))
      ) && incoming().userId == existing().userId;
    }

    function isAdmin() {
      // Placeholder for admin check if needed
      return false;
    }
  }
}
